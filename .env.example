# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Embedding provider: "huggingface" (default, free) | "openai" | "anthropic"
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Required only if EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Required only if EMBEDDING_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_EMBEDDING_MODEL=voyage-3

# Audit log output path (default: audit_log.jsonl in working directory)
AUDIT_LOG_PATH=audit_log.jsonl
