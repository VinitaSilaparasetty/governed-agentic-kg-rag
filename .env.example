# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Embedding provider: "fastembed" (default, free, ONNX — no GPU) | "openai" | "anthropic"
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Required only if EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Required only if EMBEDDING_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_EMBEDDING_MODEL=voyage-3

# Audit log output path (default: audit_log.jsonl in working directory)
AUDIT_LOG_PATH=audit_log.jsonl
