# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Embedding provider: "fastembed" (default, free, ONNX — no PyTorch/GPU required)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM for synthesis agent (free, local, open-source via Ollama)
# Install Ollama: https://ollama.com  |  then: ollama pull mistral
LLM_PROVIDER=ollama
LLM_MODEL=mistral:latest

# Audit log output path (default: audit_log.jsonl in working directory)
AUDIT_LOG_PATH=audit_log.jsonl
